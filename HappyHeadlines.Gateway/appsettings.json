{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "articles-route": {
        "ClusterId": "articles-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "articles-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "articleservice1": { "Address": "http://articleservice1:8080/" },
          "articleservice2": { "Address": "http://articleservice2:8080/" },
          "articleservice3": { "Address": "http://articleservice3:8080/" }
        }
      }
    }
  }
}
