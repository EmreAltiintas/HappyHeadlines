{
  "uid": "hh-cache-hit-ratio",
  "title": "HappyHeadlines - Cache hit ratio",
  "tags": ["happyheadlines", "cache"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ArticleCache hit ratio (selected time range)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(cache_hits_total{cache=\"ArticleCache\"}[$__range])) or vector(0)) / ((sum(increase(cache_hits_total{cache=\"ArticleCache\"}[$__range])) or vector(0)) + (sum(increase(cache_misses_total{cache=\"ArticleCache\"}[$__range])) or vector(0)))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CommentCache hit ratio (selected time range)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(cache_hits_total{cache=\"CommentCache\"}[$__range])) or vector(0)) / ((sum(increase(cache_hits_total{cache=\"CommentCache\"}[$__range])) or vector(0)) + (sum(increase(cache_misses_total{cache=\"CommentCache\"}[$__range])) or vector(0)))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CommentCache LRU evictions (selected time range)",
      "description": "Articles pushed out because the cache already held 30 articles.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cache_evictions_total{cache=\"CommentCache\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hit ratio over time (1m window)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "ArticleCache",
          "expr": "(sum(rate(cache_hits_total{cache=\"ArticleCache\"}[1m])) or vector(0)) / ((sum(rate(cache_hits_total{cache=\"ArticleCache\"}[1m])) or vector(0)) + (sum(rate(cache_misses_total{cache=\"ArticleCache\"}[1m])) or vector(0)))"
        },
        {
          "refId": "B",
          "legendFormat": "CommentCache",
          "expr": "(sum(rate(cache_hits_total{cache=\"CommentCache\"}[1m])) or vector(0)) / ((sum(rate(cache_hits_total{cache=\"CommentCache\"}[1m])) or vector(0)) + (sum(rate(cache_misses_total{cache=\"CommentCache\"}[1m])) or vector(0)))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hits and misses per second",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{cache}} hits",
          "expr": "sum by (cache) (rate(cache_hits_total[1m]))"
        },
        {
          "refId": "B",
          "legendFormat": "{{cache}} misses",
          "expr": "sum by (cache) (rate(cache_misses_total[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Firing alerts (Prometheus rules in monitoring/prometheus/alerts.yml)",
      "description": "0 = no incident. Names of firing alerts: http://localhost:9090/alerts",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Total hits / misses / evictions (counters)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{cache}} hits", "expr": "sum by (cache) (cache_hits_total)" },
        { "refId": "B", "legendFormat": "{{cache}} misses", "expr": "sum by (cache) (cache_misses_total)" },
        { "refId": "C", "legendFormat": "{{cache}} evictions", "expr": "sum by (cache) (cache_evictions_total)" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
