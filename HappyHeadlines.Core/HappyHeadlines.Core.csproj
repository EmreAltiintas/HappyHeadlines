<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
    <!-- Circuit-breaker / timeout exception types used by the Comments -> ProfanityService call.
         The resilience pipeline itself is wired up in HappyHeadlines.CommentService.WebAPI. -->
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <!-- IPublishEndpoint, used by ArticlePublisher (Publishing) to publish ArticlePublished.
         The RabbitMQ transport itself is wired up per-service in Program.cs. -->
    <PackageReference Include="MassTransit.Abstractions" Version="8.5.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HappyHeadlines.Contracts\HappyHeadlines.Contracts.csproj" />
    <ProjectReference Include="..\HappyHeadlines.Db\HappyHeadlines.Db.csproj" />
  </ItemGroup>

</Project>
